# Google Cloud / Firestore Emulator
GOOGLE_CLOUD_PROJECT=nurseshift-local
FIRESTORE_EMULATOR_HOST=localhost:8080
AUTO_SEED=true

# Microsoft Entra ID (Azure AD) nemocnice
AZURE_TENANT_ID=hospital-tenant-id
AZURE_CLIENT_ID=hospital-client-id
AUTH_DEV_MODE=true
JWT_SECRET_KEY=nurseshift-dev-secret-key-change-in-prod

# Frontend
VITE_API_URL=http://localhost:8000
VITE_AZURE_CLIENT_ID=hospital-client-id
VITE_AZURE_TENANT_ID=hospital-tenant-id
